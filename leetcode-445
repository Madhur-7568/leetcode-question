class Solution {
public:
    ListNode* addTwoNumbers(ListNode* l1, ListNode* l2) {
       stack<int>s1;
       stack<int>s2;
       stack<int>s3;
       ListNode* dummy=new ListNode(0);
       ListNode* d=dummy;
       int sum=0;
       int carry=0;
       while(l1!=NULL){
           s1.push(l1->val);
           l1=l1->next;
       } 
        while(l2!=NULL){
           s2.push(l2->val);
           l2=l2->next;
       } 
       while(!s1.empty() && !s2.empty()){
                sum=s1.top()+s2.top()+carry;
               if(sum>9){
                carry=sum/10;
                sum%=10;
               } else{
                carry=0;
               }
               s3.push(sum);
               s1.pop();
               s2.pop();
       }
       if(!s1.empty()){
        while(!s1.empty()){
                  sum=s1.top()+carry;
                   if(sum>9){
                carry=sum/10;
                sum%=10;
               } else{
                carry=0;
               }
               s3.push(sum);
               s1.pop();
        }
       }
        if(!s2.empty()){
            while(!s2.empty()){
                  sum=s2.top()+carry;
                   if(sum>9){
                carry=sum/10;
                sum%=10;
               } else{
                carry=0;
               }
               s3.push(sum);
               s2.pop();
            }
       }
       if(carry>0){
          s3.push(carry);
       }
       while(!s3.empty()){
        d->next=new ListNode(s3.top());
        d=d->next;
        s3.pop();
       }
       return dummy->next;
    }
};
