class Solution {
public:
    string addBinary(string a, string b) {
        int n=a.length();
        int m=b.length();
        int i=n-1;
        int j=m-1;
        int carry=0;
        int sum=0;
        string ans;
        stack<char>s;
        while(i>=0 && j>=0){
             sum=(a[i]-'0')+(b[j]-'0')+carry;
            if(sum>1){
                carry=sum/2;
                sum=sum%2;
            }else{
                carry=0;
            }
            s.push(sum+'0');
            i--;
            j--;
        }
        if(i>=0){
            while(i>=0){
            sum=(a[i]-'0')+carry;
            if(sum>1){
                carry=sum/2;
                sum=sum%2;
            }
              else{
                carry=0;
            }
            s.push(sum+'0');
            i--;
        }
        }
         if(j>=0){
            while(j>=0){
            sum=(b[j]-'0')+carry;
            if(sum>1){
                carry=sum/2;
                sum=sum%2;
            }
            else{
                carry=0;
            }
            s.push(sum+'0');
            j--;
        }
         }
        if(carry==1){
             s.push(carry+'0');
        }
        while(!s.empty()){
            ans.push_back(s.top());
            s.pop();
        }
        return ans;
    }
};
