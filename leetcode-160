class Solution {
public:
    ListNode *getIntersectionNode(ListNode *headA, ListNode *headB) {
        ListNode* h1=headA;
        ListNode* h2=headB;
        while(h1!=NULL){
            while(h2!=NULL){
            if(h1==h2){
                return h1;
            }
            h2=h2->next;
        }
         h2=headB;
         h1=h1->next;
        }
        return NULL;
    }
};
