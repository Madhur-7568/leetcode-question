class Solution {
public:
     int avg(vector<int>& nums,int str,int end){
        int sum=0;
        int average=0;
        for(int i=str;i<=end;i++){
            sum+=nums[i];
        }
        int avg=sum/(end-str+1);
        return avg;
     }
    int dominantIndices(vector<int>& nums) {
        int n=nums.size();
        int count=0;
         for(int i=0;i<n-1;i++){
                if(nums[i]>avg( nums,i+1,n-1)){
                    count++;
                }
         }
         return count;
    }
};
