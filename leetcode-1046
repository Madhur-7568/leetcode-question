class Solution {
public:
    
    int lastStoneWeight(vector<int>& stones) {
        while(stones.size()>1){
            int n=stones.size();
            sort(stones.begin(),stones.end());
            int x=stones[n-1];
            int y=stones[n-2];
                stones.pop_back();
                stones.pop_back();
               
             if(x!=y ){
               stones.push_back(abs(x-y)); 
            }
        }
        if(stones.empty()){
            return 0;
        }
        return stones[0];
    }
};
