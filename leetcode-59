class Solution {
public:
    vector<vector<int>> generateMatrix(int n) {
           int sr=0, sc=0 , ec=n-1, er=n-1;
           int num=1;
        vector<vector<int>>ans(n,vector<int>(n));
        while(sr<=er && sc<=ec){
            for(int i=sc;i<=ec;i++){
               ans[sr][i]=num;
                num++;
            }
            for(int i=sr+1;i<=er;i++){
                  ans[i][ec]=num;
                 num++;
            }
            for(int i=ec-1;i>=sc;i--){
                 ans[er][i]=num;
                 num++;
            }
            for(int i=er-1;i>=sr+1;i--){
                    ans[i][sc]=num;
                    num++;
            }
            sr++;
            sc++;
            er--;
            ec--;
        }
        return ans;
    }
};




  
