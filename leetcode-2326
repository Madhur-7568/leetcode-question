class Solution {
public:
    vector<vector<int>> spiralMatrix(int m, int n, ListNode* head) {
        int sr=0,er=m-1,sc=0,ec=n-1;
        ListNode* tem=head;
        vector<vector<int>>ans(m,vector<int>(n));
        while(sc<=ec && sr<=er){
            for(int i=sc;i<=ec;i++){
                ans[sr][i]=(tem?tem->val:-1); 
                if(tem){
                tem=tem->next; 
                }
            }
             for(int i=sr+1;i<=er;i++){
                  ans[i][ec]=(tem?tem->val:-1);
                   if(tem){
                tem=tem->next; 
                }
            }
            if(sr<er){
             for(int i=ec-1;i>=sc;i--){
                ans[er][i]=(tem?tem->val:-1); 
                 if(tem){
                tem=tem->next; 
                }  
            }
            }
            if(sc<ec){
            for(int i=er-1;i>sr;i--){
                ans[i][sc]=(tem?tem->val:-1);
                 if(tem){
                tem=tem->next; 
                }
            }
            }
            sr++;
            er--;
            sc++;
            ec--;
        }
        return ans;
    }
};
