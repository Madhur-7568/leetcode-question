class Solution {
public:
    int numberOfSpecialChars(string word) {
        int small[26]={0};
        int captial[26]={0};
        int count=0;
        for(int i=0;i<word.length();i++){
            if(int(word[i])>=97 && int(word[i])<=122){ 
             small[word[i]-'a']++;
            }
            if(int(word[i])>=65 && int(word[i])<=90){
             captial[word[i]-'A']++;
            }
        }
        for(int i=0;i<26;i++){
            if(small[i]!=0 && captial[i]!=0){
                count++;
            }
        }
      return count;
    }
};
