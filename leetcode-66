class Solution {
public:
    vector<int> plusOne(vector<int>& digits) {
        int n=digits.size();
        vector<int>ans;
        int carry=0;
        for(int i=n-1;i>=0;i--){
            int sum=0;
            if(i==n-1){
                sum=sum+carry+digits[i]+1;
            }
            else{
            sum=sum+carry+digits[i];
            }
            if(sum>9){
                carry=sum/10;
                sum=sum%10;
            }
            else{
                carry=0;
            }
            ans.push_back(sum);
        }
        if(carry>0){
            ans.push_back(carry);
        }
        int i=0;
        int j=ans.size()-1;
        while(i<j){
            swap(ans[i],ans[j]);
            i++;
            j--;
        }
        return ans;
    }
};
