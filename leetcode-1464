lass Solution {
 public:
 //answer-1
    int maxProduct(vector<int>& nums) {
        int n=nums.size();
        int ans;
        sort(nums.begin(),nums.end());
         ans= (nums[n-1]-1)*(nums[n-2]-1);
        return ans;
///////////////////////////////////////////////
//answer-2
    int maxProduct(vector<int>& nums) {
        int biggest = 0;
        int secondBiggest = 0;
        for (int num : nums) {
            if (num > biggest) {
                secondBiggest = biggest;
                biggest = num;
            } else {
                secondBiggest = max(secondBiggest, num);
            }
        }
        
        return (biggest - 1) * (secondBiggest - 1);
    }
};
