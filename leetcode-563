class Solution {
public:
    int ans=0;
    int ft(TreeNode* root){
            if(root==NULL){
                return 0;
            }
            int left=ft( root->left) ;
             int right=ft( root->right) ;
              ans+=abs(left-right);
        
        return left+right+root->val;
    }
    int findTilt(TreeNode* root) {
        ft(root);
        return ans;
    }
};
