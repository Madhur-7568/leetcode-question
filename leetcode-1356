class Solution {
public:
    int ones(int n){
        int one=0;
        while(n>0){
            int rem=n%2;
            if(rem==1){
               one++;
            }
            n/=2;
        }
        return one;
    }
    vector<int> sortByBits(vector<int>& arr) {
       vector< pair<int,int>>p;
         for(int i=0;i<arr.size();i++){
            p.push_back({ ones(arr[i]),arr[i]}); 
         }
         sort(p.begin(),p.end());
         vector<int>ans;
         for(auto &it :p){
            ans.push_back(it.second);
         }
         return ans;
    }
};
