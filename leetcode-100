class Solution {
public:
    bool isIdentical(TreeNode* p,TreeNode* q){
          if(p==NULL && q==NULL){
               return true;
          }
          if(p==NULL || q==NULL ){
            return false;
          }
          if(p->val != q->val){
            return false;
          }
          return isIdentical(p->left,q->left)&&isIdentical(p->right,q->right);
    }
    bool isSameTree(TreeNode* p, TreeNode* q) {
        return isIdentical(p,q);
    }
};
