class Solution {
public:
    ListNode* removeNthFromEnd(ListNode* head, int n) {
        ListNode* temp=head;
        ListNode* curr=head;
        ListNode* prev=head;
        int size=0;
          ListNode* del=NULL;
        while(temp!=NULL){
            size++;
            temp=temp->next;
        }
        if(size==n){
            del=head;
            head=head->next;
            delete del;
            return head;
        }
        int i=0;
        while(i<size-n){
              prev=curr;
              curr=curr->next;
              i++;
        }
        prev->next=curr->next;
        return head;
    }
};
