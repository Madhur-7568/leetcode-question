class Solution {
public:
    vector<int> sortArrayByParity(vector<int>& nums) {
        int n=nums.size();
       // ##  Method-1 ##
        // for(int i=0;i<n;i++){
        //     for(int j=i+1;j<n;j++){
        //         if(nums[i]%2!=0 && nums[j]%2==0){
        //             swap(nums[i],nums[j]);
        //         }
        //     }
        // }


        // ## Method-2  ## 
        int i=0;
        int j=n-1;
        while(i<j){
                    if(nums[i]%2!=0 && nums[j]%2==0){
                    swap(nums[i],nums[j]);
                } 
                else if(nums[i]%2!=0 && nums[j]%2!=0){
                    j--;
                }   
               else if(nums[i]%2==0 && nums[j]%2!=0){
                    i++;
                }   
               else{
                    i++;
               }  
        }
        return nums;
    }
};
