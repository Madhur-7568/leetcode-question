class Solution {
public:
    int missingNumber(vector<int>& nums) {
        int n=nums.size();
        int sum=0;
        int realSum=0;
        for(int i=0;i<=n;i++){
            realSum+=i;
        }
        for(int i=0;i<n;i++){
            sum+=nums[i];
        }
        return realSum-sum;
    }
};
