class Solution {
public:
    bool search(vector<int>& nums, int target) {
         vector<pair<int,int>>ans;
        int n=nums.size();
        for(int i=0;i<n;i++){
            ans.push_back({nums[i],i});
            //ans.second.push_back(i);
        }
        sort(ans.begin(),ans.end());
        int str=0;
        int end=n-1;
       // int mid=0;
        while(str<=end){
           int mid=(str+end)/2;
            if(ans[mid].first==target){
                return true;
            }
            else if(ans[mid].first>target){
                end=mid-1;
            }
            else if(ans[mid].first<target){
                str=mid+1;
            }
        }
       return false; 
    
    }
};
