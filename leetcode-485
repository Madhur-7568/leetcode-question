class Solution {
public:
    int findMaxConsecutiveOnes(vector<int>& nums) {
        int n=nums.size();
        int count=0;
        int j=0;
         int maxNum=0;
        for(int i=0;i<n;i++){
            if(nums[i]==1){
                  count++;
                  nums[j]=count;
                  j++;
            }
            else{
                count=0;
            }
        }
            for(int k=0;k<n;k++){
                maxNum=max(maxNum,nums[k]);
        }
        return maxNum;
    }
};
