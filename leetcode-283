class Solution {
public:
    void moveZeroes(vector<int>& nums) {
         int n=nums.size();
////////////////////////////////////////////////////
     ////////method1= bruetforce////////////
        for(int i=0;i<n;i++){
            for(int j=i+1;j<n;j++){
                if(nums[i]==0 && nums[j]!=0){
                    swap(nums[i],nums[j]);
                }
            }
        }
////////////////////////////////////////////////////////
///////////////Method-2//////////////        
        int i=0;
        int j=0;
        while(i<n && j<n){
            if(nums[i]==0 && nums[j]!=0){
                nums[i]=nums[j];
                nums[j]=0;
                i++;
            }
            else if(nums[i]!=0 && nums[j]!=0){
                i++;
                j++;
            }
            else{
                j++;
            }
        }

    }
};
