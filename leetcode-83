class Solution {
public:
    ListNode* deleteDuplicates(ListNode* head) {
         if(head==NULL){
            return head;
        }
        ListNode* prev=head;
        ListNode* curr=head->next;
  
        while(curr!=NULL){
            if(prev->val==curr->val){
                prev->next=curr->next;
                curr=curr->next;
            }
          else{ curr=curr->next;
           prev=prev->next;
        }
        }
        return head;
    }
};
