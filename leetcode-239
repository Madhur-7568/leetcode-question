class Solution {
public:
    vector<int> maxSlidingWindow(vector<int>& nums, int k) {
        int n=nums.size();
        priority_queue<pair<int,int>>pq;
        for(int i=0;i<k;i++){
            pq.push({nums[i],i});
        }
        vector<int>ans;
        for(int i=k;i<n;i++){
             ans.push_back(pq.top().first);
             while(!pq.empty() && pq.top().second<=(i-k)){
                pq.pop();
             }
             pq.push({nums[i],i});
        }
        ans.push_back(pq.top().first);
        return ans;
    }
};
