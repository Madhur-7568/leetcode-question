class Solution {
public:
     vector<int>ans;
     void preorder(TreeNode* root){
              if(root==NULL){
                return ;
              }
              ans.push_back(root->val);
              preorder(root->left);
               preorder(root->right);
     }
    bool isUnivalTree(TreeNode* root) {
        if(root==NULL){
            return true;
        }
         preorder(root);
          for(int i=0;i<ans.size();i++){
            if(ans[i]!=ans[0]){
                     return false;
            }
          }
           return true;
       
    }
    
 };
