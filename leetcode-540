class Solution {
public:
    int singleNonDuplicate(vector<int>& nums) {
        int n=nums.size();
       int i=0;
       int j=1;
       while(j<n&& i<n){
        if(nums[i]==nums[j]){
            i=j+1;
            j=j+2;
        }else{
            j++;
        }
       }
       return nums[i];
    }
};
