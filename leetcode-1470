class Solution {
public:
    vector<int> shuffle(vector<int>& nums, int n) {
        int j=0;
        vector<int>ans(2*n);
        for(int i=0;i<2*n;i++){
         if(i%2==0){
            ans[i]=nums[j];
            j=j+n;
         }
         else if(i%2!=0){
            ans[i]=nums[j];
            j=j-n+1;
         }
        }
        return ans;
    }
};
