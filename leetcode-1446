class Solution {
public:
    int maxPower(string s) {
        int n=s.length();
        int count=1;
        int power=0;
        for(int i=0;i<n;i++){
            if(s[i]==s[i+1]){
                count++;
            }else{
                count=1;
            }
            power=max(power,count);
        }
        return power;
    }
};
