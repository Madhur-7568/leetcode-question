class Solution {
public:
    bool helper(char ch){
        if(ch=='a'|| ch=='e'|| ch=='i'|| ch=='o'|| ch=='u'|| ch=='A'|| ch=='E'|| ch=='I'|| ch=='O'|| ch=='U'){
            return true;
        }
        return false;
    }
    string reverseVowels(string s) {
        int n=s.size();
        int str=0;
        int end=n-1;
        while(str<end){
            if(helper(s[str]) && helper(s[end])){
                swap(s[str],s[end]);
                str++;
                end--;
            }
            else if(!helper(s[str]) && helper(s[end])){
                    str++;
            }
            else if(helper(s[str]) &&  (!helper(s[end]))){
                    end--;
            }
            else{
                str++;
                end--;
            }
        }
        return s;
    }
};
