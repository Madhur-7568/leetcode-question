class Solution {
public:
    vector<int> topKFrequent(vector<int>& nums, int k) {
        int n=nums.size();
        unordered_map<int,int>m; //nums[],fre
        for(int i=0;i<n;i++){
            if(m.count(nums[i])){
                m[nums[i]]++;
            }
            else{
                m[nums[i]]=1;
            }
        }
        vector<int>ans;
        priority_queue<pair<int,int>>pq;
        for(auto  &el:m){  
           pq.push({el.second,el.first});
        }
        
        while(k>0){
            ans.push_back(pq.top().second);
            pq.pop();
            k--;
        }
        
        return ans;
    }
};
