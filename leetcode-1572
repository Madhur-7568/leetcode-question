class Solution {
public:
    int diagonalSum(vector<vector<int>>& mat) {
           int sum=0;
           int i=0;
           int n=mat.size();
           while(i<n){
           if(i==i){
            sum+=mat[i][i];
           } 
           if(i!=n-i-1){
            sum+=mat[i][n-i-1];
           }
           i++;
           }
           return sum;
    }
};
