class Solution {
public:
    TreeNode* invertTree(TreeNode* root) {
        TreeNode* curr=root;
        TreeNode* temp=NULL;
        if(curr==NULL){
            return NULL;
        }
        invertTree(curr->left);
        invertTree(curr->right);
        temp=curr->left;
        curr->left=curr->right;
        curr->right=temp;
        return root;
    }
};
