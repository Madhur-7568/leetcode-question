class Solution {
public:
    bool helper(int num) {
        int newnum=num;
        while(newnum>0){
            int rem=newnum%10;
            if(rem==0){
                return false;
            }
           else if(rem!=0){
            if((num%rem!=0)){ 
                return false;
            }
            }
            newnum/=10;
        }
        return true;
    }
    vector<int> selfDividingNumbers(int left, int right) {
        vector<int>ans;
        for(int i=left;i<=right;i++){
            if(helper(i)){
                  ans.push_back(i);
            }
        }
        return ans;
    }
};
